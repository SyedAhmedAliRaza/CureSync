# CureSync Backend Environment Variables
# Copy this file to .env and fill in your keys

# Alibaba Cloud DashScope API Key (for Qwen models)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Alibaba Cloud OCR API Key (if using separate OCR service)
# Optional - Qwen-VL can be used as fallback for prescription scanning
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
